{
  "name": "southie-burgers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute southie-burgers-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute southie-burgers-db --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute southie-burgers-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute southie-burgers-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
